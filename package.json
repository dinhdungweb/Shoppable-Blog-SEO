{
  "name": "shoppable-blog-seo",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "analytics:prune": "node scripts/prune-widget-events.mjs",
    "seo:worker": "tsx scripts/seo-scan-worker.ts",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@react-router/fs-routes": "^7.18.7",
    "@react-router/node": "^7.18.7",
    "@react-router/serve": "^7.18.7",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "13.9.5",
    "@shopify/shopify-app-react-router": "^4.0.4",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.4",
    "dompurify": "^3.4.18",
    "dotenv": "^16.6.1",
    "isbot": "^5.1.0",
    "prisma": "^6.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.18.7",
    "recharts": "^3.8.1",
    "tsx": "^4.23.1",
    "vite-tsconfig-paths": "^5.0.1"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.7",
    "@shopify/api-codegen-preset": "^1.1.1",
    "@shopify/app-bridge-types": "^0.7.5",
    "@shopify/polaris-types": "^2.0.0",
    "@types/eslint": "^9.6.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.2.4",
    "typescript": "^5.2.2",
    "vite": "^6.2.2",
    "vitest": "^3.2.7"
  },
  "workspaces": {
    "packages": [
      "extensions/*"
    ]
  },
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "resolutions": {
    "@graphql-tools/url-loader": "8.0.16",
    "@graphql-codegen/client-preset": "4.7.0",
    "@graphql-codegen/typescript-operations": "4.5.0",
    "minimatch": "9.0.7",
    "tar": "7.5.16",
    "vite": "^6.2.2"
  },
  "overrides": {
    "@graphql-tools/url-loader": "8.0.16",
    "@graphql-codegen/client-preset": "4.7.0",
    "@graphql-codegen/typescript-operations": "4.5.0",
    "minimatch": "9.0.7",
    "tar": "7.5.16",
    "vite": "^6.2.2",
    "@shopify/polaris": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "eslint-plugin-jsx-a11y": {
      "minimatch": "^3.1.4"
    },
    "eslint-plugin-import": {
      "minimatch": "^3.1.4"
    },
    "eslint-plugin-react": {
      "minimatch": "^3.1.4"
    }
  }
}
